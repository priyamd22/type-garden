---
import "../styles/style.css"
---

<!doctype html>
<html lang="en" data-mode="type">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Type Garden</title>
<meta name="theme-color" content="#000000">
<meta name="background-color" content="#000000">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Type Garden">
<link rel="icon" id="fav" type="image/png" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<meta name="generator" content={Astro.generator}>

<!-- Google Analytics -->
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-5XL2YDDFZ8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-5XL2YDDFZ8');
</script>

<!-- Meta tags for SEO and Open Graph -->
<meta name="description" content="Type Garden — a generative typography art project. Type a message, choose a flower, and watch it grow in a responsive garden that blooms with your words.">
<meta name="keywords" content="generative art, typography, animated text, poetic typography, interactive art, CSS animation, garden, flowers">
<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://type-garden.netlify.app">
<meta property="og:title" content="Type Garden — Generative Typography Art">
<meta property="og:description" content="Type a message, choose a flower, and watch it bloom. A poetic interactive typography experience.">
<meta property="og:image" content="https://type-garden.netlify.app/images/opengraph.png">
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="https://type-garden.netlify.app">
<meta property="twitter:title" content="Type Garden — Generative Typography Art">
<meta property="twitter:description" content="Type a message, choose a flower, and watch it bloom.">
<meta property="twitter:image" content="https://type-garden.netlify.app/images/opengraph.png">
</head>
<body>
<div data-tg="app" id="app">
  <canvas id="cv"></canvas>
  <input id="inp" aria-label="Type to grow a garden" autocapitalize="off" autocomplete="off" autocorrect="off" spellcheck="false">

  <div data-tg="hdr" id="hdr">
    <span class="credit"><span class="made">Made with </span><span class="heart">♥️</span> by Priyam Ghosh</span>
    <div class="hdr-actions">
      <a id="kofi" href="https://ko-fi.com/bokunomaou" target="_blank" rel="noopener" aria-label="Support me on Ko-fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h12v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Z"/><path d="M16 9h2a2 2 0 0 1 0 4h-2"/><path d="M7 2v2M11 2v2M15 2v2"/></svg><span>Ko-fi</span></a>
      <a id="github" href="https://github.com/priyamd22/type-garden" target="_blank" rel="noopener" aria-label="View source on GitHub" title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/></svg></a>
    </div>
  </div>
  <div data-tg="modes" id="modes"></div>

  <div data-tg="bar" id="bar">
    <div data-tg="hints">
      <span data-tg="fine">type to grow</span><span data-tg="coarse">tap to type</span>
      <span><kbd>space</kbd>cuts</span>
      <span><kbd>⌫</kbd>withers</span>
      <span><kbd>↵</kbd>clears</span>
      <span data-tg="fine"><kbd>⇧ ↵</kbd>new line</span>
    </div>
    <div data-tg="ctrls" id="ctrls"></div>
  </div>

  <div data-tg="poster" id="poster" hidden>
    <div data-tg="panel">
      <div class="sec" style="gap:4px">
        <div class="ttl">Poster</div>
        <div class="sub" id="info"></div>
      </div>
      <div class="sec">
        <div class="lbl">Words</div>
        <textarea id="ptext" rows="2" spellcheck="false"></textarea>
        <div class="sub">Enter starts a new line</div>
        <button class="ghost" id="regrow" style="align-self:flex-start">Regrow garden</button>
      </div>
      <div class="sec">
        <div class="lbl">Format</div>
        <div class="grid2" id="rgrid"></div>
      </div>
      <div class="sec">
        <div class="lbl">Flowers</div>
        <div class="grid2" id="fgrid"></div>
      </div>
      <div class="sec">
        <div class="lbl">Motion</div>
        <div class="grid2" id="presets"></div>
      </div>
      <div class="sec">
        <div class="lbl">Palette</div>
        <div class="grid2" id="pgrid"></div>
      </div>
      <div class="sec exp">
        <div class="lbl" id="explbl">Export · 1080 × 1080 loop</div>
        <button id="vid"></button>
        <button id="gifbtn">GIF loop · 540 px</button>
        <button id="frames">PNG frames (.zip)</button>
        <div class="sub" id="status" style="min-height:16px"></div>
      </div>
    </div>
    <div data-tg="stage">
      <canvas id="pcv" width="1080" height="1080"></canvas>
    </div>
  </div>
</div>

<script src="../scripts/typegarden.js"></script>
</body>
</html>
